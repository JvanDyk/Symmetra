{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "description": "Symmetra Build Configuration",
  "version": "1.0.0",
  "build": {
    "name": "Symmetra",
    "version": "1.0.0",
    "description": "GPU Compute Engine - TypeScript to CUDA C++",
    "targetPlatform": "Windows x64",
    "cudaMinVersion": "13.1",
    "cmakeMinVersion": "3.20"
  },
  "compiler": {
    "msvc": {
      "version": "19.44",
      "visualStudioVersion": "2022",
      "architecture": "x64",
      "warningsAsErrors": true,
      "optimizationLevel": "O2"
    }
  },
  "security": {
    "enableCodeSigning": true,
    "signTimestampServer": "http://timestamp.comodoca.com",
    "checksumsAlgorithm": "SHA256",
    "validateDependencies": true,
    "enableSecurityHardening": true,
    "enableDataExecutionPrevention": true,
    "enableAddressSpaceLayoutRandomization": true,
    "enableControlFlowGuard": true
  },
  "optimization": {
    "enableLinkTimeOptimization": true,
    "enableWholeProgramOptimization": true,
    "parallelJobs": 8,
    "precompiledHeaders": true,
    "inlining": "aggressive"
  },
  "testing": {
    "runTests": true,
    "failOnTestFailure": true,
    "generateCoverage": false,
    "suites": [
      "codegen_test",
      "benchmark_test",
      "scalability_test",
      "robustness_test",
      "performance_test"
    ]
  },
  "distribution": {
    "createPackage": true,
    "packageFormat": "zip",
    "includeDocumentation": true,
    "includeInstaller": true,
    "generateChecksums": true,
    "platforms": [
      {
        "name": "Windows",
        "architecture": "x64",
        "format": "zip"
      }
    ]
  },
  "artifacts": {
    "binaries": [
      {
        "name": "sym.exe",
        "type": "executable",
        "description": "Symmetra GPU Compute Engine server",
        "sign": true,
        "strip": false
      },
      {
        "name": "codegen_test.exe",
        "type": "test",
        "description": "Code generation test suite (809 assertions)",
        "sign": true,
        "strip": false
      },
      {
        "name": "benchmark_test.exe",
        "type": "test",
        "description": "Performance benchmark suite",
        "sign": true,
        "strip": false
      },
      {
        "name": "scalability_test.exe",
        "type": "test",
        "description": "Scalability and load test suite",
        "sign": true,
        "strip": false
      },
      {
        "name": "robustness_test.exe",
        "type": "test",
        "description": "Robustness and reliability test suite",
        "sign": true,
        "strip": false
      },
      {
        "name": "performance_test.exe",
        "type": "test",
        "description": "Comprehensive performance metrics suite",
        "sign": true,
        "strip": false
      }
    ],
    "documentation": [
      "README.md",
      "QUICK_START.md",
      "EXAMPLES.md",
      "DEPLOYMENT_GUIDE.md",
      "PRODUCTION_READINESS_AUDIT.md",
      "PROJECT_COMPLETION_SUMMARY.md",
      "BUILD_PROCEDURES.md",
      "LICENSE.txt"
    ]
  },
  "verification": {
    "validateBinaries": true,
    "validateIntegrity": true,
    "validateSignatures": true,
    "validateChecksums": true,
    "performSecurityScan": true
  },
  "logging": {
    "enableDetailedLogging": true,
    "logLevel": "INFO",
    "logDirectory": "dist/logs",
    "retentionDays": 30
  },
  "environment": {
    "variables": {
      "CUDA_TOOLKIT_PATH": "${CUDA_PATH}",
      "CMAKE_GENERATOR": "Visual Studio 17 2022",
      "CMAKE_GENERATOR_PLATFORM": "x64",
      "MSVC_TOOLSET": "v143"
    }
  }
}
