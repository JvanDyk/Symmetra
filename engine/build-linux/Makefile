	$(MAKE) $(MAKESILENT) -f CMakeFiles/encrypt_ptx.dir/build.make CMakeFiles/encrypt_ptx.dir/tools/encrypt_ptx.cpp.o
.PHONY : tools/encrypt_ptx.cpp.o

tools/encrypt_ptx.i: tools/encrypt_ptx.cpp.i
.PHONY : tools/encrypt_ptx.i

# target to preprocess a source file
tools/encrypt_ptx.cpp.i:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/encrypt_ptx.dir/build.make CMakeFiles/encrypt_ptx.dir/tools/encrypt_ptx.cpp.i
.PHONY : tools/encrypt_ptx.cpp.i

tools/encrypt_ptx.s: tools/encrypt_ptx.cpp.s
.PHONY : tools/encrypt_ptx.s

# target to generate assembly for a file
tools/encrypt_ptx.cpp.s:
	$(MAKE) $(MAKESILENT) -f CMakeFiles/encrypt_ptx.dir/build.make CMakeFiles/encrypt_ptx.dir/tools/encrypt_ptx.cpp.s
.PHONY : tools/encrypt_ptx.cpp.s

