{
  "name": "symmetra-functions",
  "description": "Symmetra Cloud Functions",
  "scripts": {
    "build":       "tsc",
    "build:watch": "tsc --watch",
    "serve":       "npm run build && firebase emulators:start --only functions",
    "shell":       "npm run build && firebase functions:shell",
    "start":       "npm run shell",
    "logs":        "firebase functions:log"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin":     "^12.1.0",
    "firebase-functions": "^4.6.0"
  },
  "devDependencies": {
    "@types/node":  "^18.19.0",
    "typescript":   "^5.4.5"
  },
  "private": true
}
